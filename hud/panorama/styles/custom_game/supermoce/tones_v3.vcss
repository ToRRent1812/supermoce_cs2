/* Fixed 32-tone palette generated from the skill colours. 0-3 are semantic. */

.tone-0 { color: #E5484D; }
.bg-tone-0 { background-color: #E5484D; border-color: #E5484D; }
.bl-tone-0 { border-left-color: #E5484D; }

