<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API"/>
    <PackageReference Include="MaxMind.Db" />
    <PackageReference Include="Newtonsoft.Json"/>
    <PackageReference Include="PanoramaManager" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(PkgPanoramaManager)/lib/net10.0/PanoramaManager.dll" CopyToOutputDirectory="PreserveNewest" Link="PanoramaManager.dll" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="gamedata\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
